# Порт сервера Cap на хосте
CAP_PORT=3000

# Пароль администратора для входа в панель управления (ОБЯЗАТЕЛЬНО СМЕНИТЕ)
ADMIN_KEY=your_super_secret_admin_password_here

# Разрешенные домены для CORS (или * для всех)
CORS_ORIGIN=*

# Заголовок для реального IP клиента за Nginx/Cloudflare (X-Forwarded-For, CF-Connecting-IP, X-Real-IP)
RATELIMIT_IP_HEADER=X-Forwarded-For
